generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMPANY
}

enum AnalysisStatus {
  AUTHENTIC
  SUSPICIOUS
  COUNTERFEIT
  NO_LOGO_DETECTED
  ERROR
}

model Company {
  id             Int             @id
  name           String
  brandSlug      String          @unique
  users          User[]
  crawlerResults CrawlerResult[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  fullName         String?
  companyName      String?
  companyId        Int?
  role             Role              @default(COMPANY)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  analyses         Analysis[]
  referenceLogos   ReferenceLogo[]
  violationReports ViolationReport[]

  @@index([companyId])
}

model Analysis {
  id                String         @id @default(cuid())
  userId            String?
  guestToken        String?
  originalImagePath String
  croppedLogoPath   String?
  status            AnalysisStatus
  statusLabel       String
  confidence        Float?
  brandName         String?
  similarityScore   Float?
  sourceType        String?
  sourceUrl         String?
  notes             String?
  aiRawResponse     Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  violationReports ViolationReport[]

  @@index([userId])
  @@index([guestToken])
  @@index([status])
}

model ReferenceLogo {
  id        String   @id @default(cuid())
  userId    String
  brandName String
  imagePath String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([brandName])
}

model ViolationReport {
  id          String   @id @default(cuid())
  userId      String
  analysisId  String?
  reportType  String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([analysisId])
}

model CrawlerResult {
  id                  String    @id @default(cuid())
  companyId           Int
  brand               String
  sourceType          String
  sourceName          String?
  sourceUrl           String
  platform            String?
  title               String?
  description         String?
  imageUrl            String?
  localImagePath      String?
  sellerName          String?
  sellerProfileUrl    String?
  productStatus       String    @default("pending_analysis")
  productStatusLabel  String    @default("Pending Analysis")
  productConfidence   Float?
  brandName           String?
  similarityScore     Float?
  croppedLogoPath     String?
  aiNotes             Json?
  accountLabel        String?
  fakeProbability     Float?
  realProbability     Float?
  accountScorePercent Float?
  targetSite          String?
  searchQuery         String?
  capturedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([brand])
  @@index([sourceType])
  @@index([productStatus])
  @@index([accountLabel])
  @@index([capturedAt])
}
