generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMPANY
}

enum AnalysisStatus {
  AUTHENTIC
  SUSPICIOUS
  COUNTERFEIT
  NO_LOGO_DETECTED
  ERROR
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  fullName         String?
  companyName      String?
  role             Role              @default(COMPANY)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  analyses         Analysis[]
  referenceLogos   ReferenceLogo[]
  violationReports ViolationReport[]
}

model Analysis {
  id                String         @id @default(cuid())
  userId            String?
  guestToken        String?
  originalImagePath String
  croppedLogoPath   String?
  status            AnalysisStatus
  statusLabel       String
  confidence        Float?
  brandName         String?
  similarityScore   Float?
  sourceType        String?
  sourceUrl         String?
  notes             String?
  aiRawResponse     Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  violationReports ViolationReport[]

  @@index([userId])
  @@index([guestToken])
  @@index([status])
}

model ReferenceLogo {
  id        String   @id @default(cuid())
  userId    String
  brandName String
  imagePath String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([brandName])
}

model ViolationReport {
  id          String   @id @default(cuid())
  userId      String
  analysisId  String?
  reportType  String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([analysisId])
}
